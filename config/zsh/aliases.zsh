# Files
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'
alias -- -='cd -'

# Shell
alias reload='source ~/.zshrc'
alias p='proxy_on'
alias po='proxy_off'
alias ts='trash'

# Editors and agents
alias vim='nvim'
alias cc='claude'
alias c-d='claude --dangerously-skip-permissions'
